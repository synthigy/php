# Keep the distributed package lean: `composer require synthigy/sdk`
# should pull src/ + bin/ + docs, not the test suite or the worked
# example. This is Composer's equivalent of sdk/js/package.json's
# "files" allowlist. Everything below is in the repo but excluded from
# the dist tarball.
/tests            export-ignore
/codegen-example  export-ignore
/phpunit.xml.dist export-ignore
/phpstan.neon     export-ignore
/.gitattributes   export-ignore
/.gitignore       export-ignore

# Normalize line endings so a Windows checkout doesn't produce a dirty
# tree or break the `#!/usr/bin/env php` shebang on bin/synthigy-codegen.
* text=auto eol=lf
